include README.md README.en.md LICENSE constraints.txt
include .gitignore .gitattributes .editorconfig
recursive-include gear_contact *.py
recursive-include examples *.py *.json *.csv *.png *.svg *.pdf *.npz
recursive-include docs *.md *.json
recursive-include .github *.yml
recursive-include tests *.py
prune output
global-exclude __pycache__ *.py[cod]
